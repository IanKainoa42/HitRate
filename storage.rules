rules_version = '2';

// StuntScope stunt video + per-frame stability JSON, one object pair per rep:
//   teams/{teamId}/stunts/{attemptId}.mov
//   teams/{teamId}/stunts/{attemptId}.json
// The attempt document's `videoRef` points here (firestore.rules checks the
// prefix). Access mirrors the folder: owner or member reads, any member
// uploads. Nothing else lives in the bucket — HitRate itself stores no files.
service firebase.storage {
  match /b/{bucket}/o {
    function teamData(teamId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)).data;
    }
    function inTeam(teamId) {
      let t = teamData(teamId);
      return request.auth != null
        && (t.ownerUID == request.auth.uid || request.auth.uid in t.memberIds);
    }

    // Objects are LOGGER-OWNED, like attempts: the uploader stamps its uid
    // into custom metadata (`loggerId`) and only that uid may replace or
    // delete the object. A member can't swap in a different clip under a rep
    // that still attributes to someone else. Create is create-only — an
    // existing object is never silently overwritten by a second upload.
    function uploadIsOwn() {
      return request.resource.metadata != null
        && request.resource.metadata.loggerId == request.auth.uid
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*|application/json');
    }
    function ownsObject() {
      return resource.metadata != null
        && resource.metadata.loggerId == request.auth.uid;
    }

    match /teams/{teamId}/stunts/{file} {
      allow read:   if inTeam(teamId);
      allow create: if inTeam(teamId) && resource == null && uploadIsOwn();
      allow update: if inTeam(teamId) && ownsObject() && uploadIsOwn();
      allow delete: if inTeam(teamId) && ownsObject();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
