{
  "name": "hitrate-firestore-rules",
  "private": true,
  "scripts": {
    "test:rules": "firebase emulators:exec --project demo-hitrate-rules --only firestore,storage \"node --test --test-concurrency=1 FirestoreRulesTests/*.test.mjs\"",
    "test:firestore-rules": "firebase emulators:exec --project demo-hitrate-rules --only firestore \"node --test FirestoreRulesTests/firestore.rules.test.mjs\"",
    "test:storage-rules": "firebase emulators:exec --project demo-hitrate-rules --only firestore,storage \"node --test FirestoreRulesTests/storage.rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.17.1",
    "firebase-tools": "15.31.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "uuid": "11.1.1",
    "re2": "1.27.0"
  }
}
