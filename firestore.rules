rules_version = '2';

// HitRate cloud sync — multi-user team sharing.
//
// Layout (matches SyncEngine.swift / FirestoreModels.swift):
//   teams/{teamId}                          FTeam meta (ownerUID, memberIds)
//   teams/{teamId}/subjects/{id}            FSubject   (owner writes, members read)
//   teams/{teamId}/groups/{id}              FGroup     (owner writes, members read)
//   teams/{teamId}/templates/{id}           FTemplate  (owner writes, members read)
//   teams/{teamId}/sessions/{id}            FSession   (logger-owned)
//   teams/{teamId}/attempts/{id}            FAttempt   (any member logs own reps)
//   joinCodes/{code}                        { teamId } — public code→team lookup
//
// Roster is OWNER-authoritative; attempts are append-only and tagged with the
// logger's uid. A joiner resolves one exact, non-listable code via joinCodes/,
// then adds only itself to the team's memberIds (the sole member-write allowed
// on the team doc). Team ids are random UUIDs and act as the resolved capability.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // Parent-team lookup for subcollection rules.
    function teamData(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }
    function ownsTeam(teamId) {
      return signedIn() && teamData(teamId).ownerUID == uid();
    }
    function inTeam(teamId) {
      let t = teamData(teamId);
      return signedIn() && (t.ownerUID == uid() || uid() in t.memberIds);
    }

    function changesOnlyOwnMembership() {
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return before is list
        && after is list
        && request.resource.data.ownerUID == resource.data.ownerUID
        && request.resource.data.updatedAt == request.time
        && changed.hasOnly(['memberIds', 'updatedAt'])
        && (
          // First redemption: preserve everyone and add exactly the caller.
          (!(uid() in before) && after == before.concat([uid()]))
          // Leave: preserve everyone else, including any legacy duplicates.
          || (uid() in before && after == before.removeAll([uid()]))
          // Re-entering the same code is an idempotent membership update.
          || (uid() in before && after == before)
        );
    }

    match /teams/{teamId} {
      allow read:   if signedIn() && (resource.data.ownerUID == uid()
                                       || uid() in resource.data.memberIds);
      allow create: if signedIn() && request.resource.data.ownerUID == uid();
      allow delete: if signedIn() && resource.data.ownerUID == uid();
      // Owner: full update. Non-owner: may add/remove only their own uid (or
      // idempotently rejoin), while preserving every other member and field.
      allow update: if signedIn() && (
        resource.data.ownerUID == uid()
        || changesOnlyOwnMembership()
      );

      match /subjects/{docId} {
        allow read:  if inTeam(teamId);
        allow write: if ownsTeam(teamId);
      }
      match /groups/{docId} {
        allow read:  if inTeam(teamId);
        allow write: if ownsTeam(teamId);
      }
      match /templates/{docId} {
        allow read:  if inTeam(teamId);
        allow write: if ownsTeam(teamId);
      }
      match /sessions/{docId} {
        allow read:   if inTeam(teamId);
        allow create: if inTeam(teamId) && request.resource.data.loggerId == uid();
        allow update: if inTeam(teamId)
          && resource.data.loggerId == uid()
          && request.resource.data.loggerId == resource.data.loggerId;
        allow delete: if inTeam(teamId) && resource.data.loggerId == uid();
      }
      match /attempts/{docId} {
        allow read:   if inTeam(teamId);
        allow create: if inTeam(teamId) && request.resource.data.loggerId == uid();
        // Attribution is immutable. Only the original logger can edit or
        // tombstone a rep; a folder owner cannot rewrite a member's history.
        allow update: if inTeam(teamId)
          && resource.data.loggerId == uid()
          && request.resource.data.loggerId == resource.data.loggerId;
        allow delete: if inTeam(teamId) && resource.data.loggerId == uid();
      }
    }

    // Remote kill switch (`config/ios` → { minBuild }). Every client reads it on
    // launch; nobody may write it from the app — bumping minBuild is a console /
    // admin-SDK operation only, so a compromised client can't lock the fleet out.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Exact code→team lookup so a joiner can resolve a 6-digit code before
    // they're a member. Listing is forbidden: the directory is not an invite
    // catalog. Owner-written; exact documents hold only { teamId, ownerUID }.
    match /joinCodes/{code} {
      allow get:    if signedIn();
      allow list:   if false;
      allow create: if signedIn() && request.resource.data.ownerUID == uid();
      allow update, delete: if signedIn() && resource.data.ownerUID == uid();
    }
  }
}
