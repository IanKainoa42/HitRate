rules_version = '2';

// HitRate cloud sync — multi-user team sharing.
//
// Layout (matches SyncEngine.swift / FirestoreModels.swift):
//   teams/{teamId}                          FTeam meta (ownerUID, memberIds)
//   teams/{teamId}/subjects/{id}            FSubject   (owner writes, members read)
//   teams/{teamId}/groups/{id}              FGroup     (owner writes, members read)
//   teams/{teamId}/templates/{id}           FTemplate  (owner writes, members read)
//   teams/{teamId}/attempts/{id}            FAttempt   (any member logs own reps)
//   joinCodes/{code}                        { teamId } — public code→team lookup
//
// Roster is OWNER-authoritative; attempts are append-only and tagged with the
// logger's uid. A joiner resolves a code via joinCodes/, then adds only itself
// to the team's memberIds (the sole member-write allowed on the team doc).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // Parent-team lookup for subcollection rules.
    function teamData(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }
    function ownsTeam(teamId) {
      return signedIn() && teamData(teamId).ownerUID == uid();
    }
    function inTeam(teamId) {
      let t = teamData(teamId);
      return signedIn() && (t.ownerUID == uid() || uid() in t.memberIds);
    }

    match /teams/{teamId} {
      allow read:   if signedIn() && (resource.data.ownerUID == uid()
                                       || uid() in resource.data.memberIds);
      allow create: if signedIn() && request.resource.data.ownerUID == uid();
      allow delete: if signedIn() && resource.data.ownerUID == uid();
      // Owner: full update. Member: may change ONLY memberIds/updatedAt (join or
      // leave), and only to add or remove THEMSELVES — never touch other fields.
      allow update: if signedIn() && (
        resource.data.ownerUID == uid()
        || (
          request.resource.data.ownerUID == resource.data.ownerUID
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        )
      );

      match /subjects/{docId} {
        allow read:  if inTeam(teamId);
        allow write: if ownsTeam(teamId);
      }
      match /groups/{docId} {
        allow read:  if inTeam(teamId);
        allow write: if ownsTeam(teamId);
      }
      match /templates/{docId} {
        allow read:  if inTeam(teamId);
        allow write: if ownsTeam(teamId);
      }
      match /attempts/{docId} {
        allow read:   if inTeam(teamId);
        allow create: if inTeam(teamId) && request.resource.data.loggerId == uid();
        allow update, delete: if signedIn()
          && (resource.data.loggerId == uid() || ownsTeam(teamId));
      }
    }

    // Public code→team directory so a joiner can resolve a 6-digit code before
    // they're a member. Owner-written; readable by any signed-in user. Holds only
    // { teamId } — no roster data leaks.
    match /joinCodes/{code} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUID == uid();
      allow update, delete: if signedIn() && resource.data.ownerUID == uid();
    }
  }
}
